; Non-doctrine sequence buy, used for Soviet ART teams
(define "squad_with2types_i"
	{"%name(%side)"
		{charge 
			{delay %cd}
			{interval %ci}
		}
		{content "mp/%side/%period/%c1 mp/%side/%period/%c2"}
		{tags "all infantry %side %t %period"}
		{group "%g"}
		{button "%b"}
		{level 1}
		{squad_cost_factor 1}
		{round_multiple 1}
		{icon %i}
	}
)

; 3 identical vehicles with 1 types of crew. Used for US Mortar Troop (3x)
(define "squad_3vehicle_doctrine"
	("generic_d" t(%side %period))
	{content "%vehicle ( mp/%side/%period/%crew ) %vehicle ( mp/%side/%period/%crew ) %vehicle ( mp/%side/%period/%crew )"}
)

; 2 sets of 4 vehicles, each set with 1 crew type. Used for US towed gun battery
(define "squad_8vehicle_doctrine"
	("generic_d" t(%side %period))
	{content "%vehicle1 ( mp/%side/%period/%crew1 ) %vehicle2 ( mp/%side/%period/%crew2 ) %vehicle1 ( mp/%side/%period/%crew1 ) %vehicle2 ( mp/%side/%period/%crew2 ) %vehicle1 ( mp/%side/%period/%crew1 ) %vehicle2 ( mp/%side/%period/%crew2 ) %vehicle1 ( mp/%side/%period/%crew1 ) %vehicle2 ( mp/%side/%period/%crew2 )"}
)

; 2 different vehicles with 5 types of crew on both, plus an additional 3 soldier types
(define "squad_2_vehicle5_3_doctrine"
	("generic_d" t(%side %period)) 
	{content "%vehicle1 ( mp/%side/%period/%c1 mp/%side/%period/%c2 mp/%side/%period/%c3 mp/%side/%period/%c4 mp/%side/%period/%c5 ) %vehicle2 ( mp/%side/%period/%c6 mp/%side/%period/%c7 mp/%side/%period/%c8 mp/%side/%period/%c9 mp/%side/%period/%c10 )  mp/%side/%period/%c11  mp/%side/%period/%c12  mp/%side/%period/%c13"}
)

; squad setup for 11 types
(define "squad_with11types_doctrine"
	("generic_d_inf" t(%side %period))
	{content "mp/%side/%period/%c1 mp/%side/%period/%c2 mp/%side/%period/%c3 mp/%side/%period/%c4 mp/%side/%period/%c5 mp/%side/%period/%c6 mp/%side/%period/%c7 mp/%side/%period/%c8 mp/%side/%period/%c9 mp/%side/%period/%c10 mp/%side/%period/%c11"}
)