(define "squad_with2types_1vehicle_sequence_spearhead"
	{charge 
		{delay %cd}
		{interval %ci}
	}
	{content "%vehicle1 ( mp/%side/%period/%crew1 mp/%side/%period/%crew2 )"}
	{tags "all %side %t %period"}
	{group "%g"}
	{button "%b"}
	{doctrine %d}
	{level 1}
	{squad_cost_factor %scf}
	{round_multiple 5}
)

;1 vehicle, 1 crew type
(define "squad_with1types_1vehicle_spearhead"
