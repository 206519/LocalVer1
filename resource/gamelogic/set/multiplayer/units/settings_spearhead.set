		{charge 
			{delay %cd}
			{interval %ci}
		}
		{content "%vehicle1 ( mp/%side/%period/%crew1 )"}
		{tags "all %side %t %period"}
		{group "%g"}
		{button "%b"}
		{doctrine %d}
		{level 1}
		{squad_cost_factor %scf}
		{round_multiple 5}
	}
)

