;SDL

;===================================
;        INSTRUCTIONS    
;===================================

; In this file onee configures the humans which are spawned in vehicles or squads
; The humans have a CP and cost associated with them which collectively add up for the final squad value
; Check ../settings_inf.set for the global defines for CP, capture weight (CW), score, etc.

;===================================
;        PRICING CHART	       
;===================================

; // Standard prices below are for tier2 infantry
;Unarmed				= 7
;Sidearm				= 8
;Shotgun				= 9

;Bolt-Action Rifles:
;K98					= 9
;Enfield (10-rd)		= 10
;M1903					= 9
;Mosin					= 9
;sniper					= 50

;Submachineguns:
;MP 38/40				= 11
;Sten					= 10
;M1/M1A1 (20-rd)		= 10
;M1/M1A1 (30-rd)		= 11
;M1928 (50-rd)			= 13
;M3/M3A1				= 10
;PPD-40/PPSH-41	(35-rd)	= 12
;PPD-40/PPSH-41 (71-rd)	= 14
;PPS-43					= 11

;Self-Loading Rifles
;G 41					= 13
;G 43/K 43				= 14
;Mkb 42					= 14
;MP 43/StG 44			= 15
;FG 42					= 19
;Bren					= 19
;M1 Carbine				= 12
;M1 Garand				= 14
;BAR					= 19
;SVT-40					= 14
;AVT-40					= 14
;sniper					= 55

;Machineguns
;MG 26(t) (20-rd)		= 19
;MG 13 (75-rd)			= 23
;MG 34 (50-rd)			= 22
;MG 34 (100-rd)			= 23
;MG 42 (50-rd)			= 22
;MG 42 (100-rd)			= 23
;Lewis (47-rd)			= 22
;Vickers K (60-rd)		= 22
;M1919A6 (100-rd)		= 23
;DP-27/28				= 22
;MG Ammo Carrier		= +1

;Anti-Tank Weapons
;Anti-tank Grenade		= +1
;PzB 39					= 20
;% Panzerfaust 30		= +1
;Panzerfaust 30			= 2
;% Panzerfaust 60		= +2
;Panzerfaust 60			= 4
;% Panzerfaust 100		= +3
;Panzerfaust 100		= 6
;RPzB 54				= 55
;Boys AT Rifle			= 15
;Bazooka M1				= 40
;Bazooka M9				= 44
;PTRD					= 15
;PTRS					= 25
;AT Ammo Carrier		= +2

;Special
;Rifle Grenade			= +12
;Recon					= +2 (increased view range)
;Flamethrower			= 40
;Engineer				= 40
;Minelayer				= 40
;Tank Crew (pistol)		= 10/15/20	(standard/veteran/ace)
;Tank Crew (SMG)		= 12/17/22
;Tank Commander	(SMG)	= 15/20/25
;Body Armor				= +10
;Mine Detector			= +3
;Builder				= +15


; // price modifiers (If not tier2)
;tier 0 		= -6
;tier 1 		= -3
;tier 1 vet 	= 0
;tier 2 vet		= +3
;tier 3 		= +6
;tier 3 vet 	= +9
;tier 4 		= +13
;tier 4 vet 	= +16

