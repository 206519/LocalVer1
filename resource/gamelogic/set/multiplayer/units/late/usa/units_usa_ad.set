;A.D "Replacements" Rifle Squad (Late)
("squad_with8types_doc" side(usa) name(squad_arm_rep_rifle_late_ad) d(late_usa_ad) period(late) scf(1) cd(0) ci(0) g(squad_1) c1(ar_sl_carbine:1) c2(ar_late_rep_sl_asst:1) c3(ar_late_rep_rifle_gren:2) c4(ar_late_rep_rifle_at_m9a1:1) c5(ar_late_rep_rifle_at_asst:1) c6(ar_late_rep_rifle:3) c7(ar_late_rep_rifle_bar:1) c8(ar_late_rep_rifle_bar_asst:1) b(inf1) t())

