{Pathers
	; default profile must be first
	; Terrain:
	;   K <= 0	- move disabled
	;   K >= 1	- move without penalties
	;   0 < K < 1 - speed = maxSpeed * K
	;   cost = 1 / K
	; Height:
	;   cost < 0 - move disabled
	;   cost = 0 - move without penalties
	;   cost > 0 - move with penalties
	; pathCost = distance * (terrainCost + heightCost)

	{Profile "nothing"
		{Radius 0}
		{Priority 0}
		{Terrain
			"ground"		1
			"forest"		1
			"slope"			1
			"no_pass"		1
			"shallow_water"	1
			"water"			1
			"deep_water"	1
		}
	}

	(define "humanprofile"
		{Network}
		{Human}
		{Priority 1}
		{Radius 0.3}
		{Terrain
			"road"			1.00
			"ground"		0.90
			"snow"			0.90
			"no_pass"		0.90
			"no_pass_human"	0
			"forest"		0.70
			"slope"			0.50
			"swamp"			0.40
			"shallow_water"	0.40
			"water"			0.30
			"deep_water"	0.30
		}
		{Height
			0  0  0  0  0 ;//  0...6..12..18..24..29
			0  0  0  0 -1 ;// 30..36..42..48..54..59
		   -1 -1 -1 -1 -1 ;// 60..66..72..78..84..90
		}
	)

	{Profile "human"
		("humanprofile")
	}

	{Profile "human_tpc"
		("humanprofile")
		{Radius 0.4}
	}

	{Profile "human_prone"
		("humanprofile")
	}

	{Profile "human_flying"
		{Priority 1}
		{Radius 0.3}
		{Human}
		{Height
			0  0  0  0  2 ;//  0...6..12..18..24..29
			2  2 -1 -1 -1 ;// 30..36..42..48..54..59
		   -1 -1 -1 -1 -1 ;// 60..66..72..78..84..90 
		}
	}

	{Profile "animal"
		{Priority 0}
		{Radius 0.3}
