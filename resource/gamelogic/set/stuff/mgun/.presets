(define "reload_belt"
	("reload time" seconds(6.3)) ;// does not apply to MG34/42 drum
)

(define "penetration"
	;{projectileDamageTable 	{40 %0} {120 %1} {190 %2} {250 %3} {305 %4} {400 0}}
	{projectileDamageTable 	{60 %0} {155 %1} {240 %2} {315 %3} {405 %4} {500 0}} ;ER
	;//100m, 600, 1000, 1500
)

(define "armor health"
	{minimumDamageModifier (* 1.0 %damage)}
)

(define "ger_ap_bullets"
	("penetration" args 11 9.6 6.3 2 0) ;// SmK L'spur / ball belts
	{curve "bullet_mg"}

	{parameters "ap"
		("penetration" args 14 6.5 3.5 2 0) ;// SmK
		("armor health" damage(7))
		{cursorReloading "gun_ap"}
		{curve "bullet_mg"}
	}
	{parameters "ap2"
		("penetration" args 22 10 5 3 0) ;// SmK(H)
		("armor health" damage(7))
		{cursorReloading "gun_ap"}
		{curve "bullet_mg"}
	}
)

(define "rus_ap_bullets"
	{parameters "ap"
		("penetration" args 14 6.5 3.5 2 0) ;// B-30
		("armor health" damage(7))
		{cursorReloading "gun_ap"}
		{curve "bullet_mg"}
	}
	{parameters "api"
		("penetration" args 14 6.5 3.5 2 0) ;// B-32
		("armor health" damage(7))
		{cursorReloading "gun_api"}
		("human health" damage(110))
		{curve "bullet_mg"}
	}
)
