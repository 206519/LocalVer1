;/*=========================*/

(define "burst_short"
	{burst
		{short 4 1}			;// short burst shots on long distance, rand (+-)shots
		{long 5 2}				;// long burst shots on short distance, rand (+-)shots
		{rangeKoef 0.5}			;// rangeKoef * aimRange = max long burst distance
	}
)

(define "burst_medium"
	{burst
		{short 5 1}
		{long 7 3}
		{rangeKoef 0.5}
	}
)

(define "burst_long"
	{burst
		{short 6 1}
		{long 9 3}
		{rangeKoef 0.5}
	}
)

(define "burst_stand"	;// basically for Maxims
	{burst
		{short 10 3}
		{long 20 3}
		{rangeKoef 0.75}
	}
)

(define "burst_aa"
	{burst
		{short 12 0}
		{long 25 3}
		{rangeKoef 0.5}
	}
)

(define "burst_aa_quad"
	{burst
		{short 12 1}
		{long 16 2}
		{rangeKoef 0.5}
	}
)

