	("penetration" args 14 6.5 3.5 2 0) ;// AP, M2
	{curve "bullet_mg"}
)

(define "airborne_mg"
	{range 130 130}
	(mod not "mp"
		{range 300 500}
	)

	{spreading
		{SpreadPower 1}
		{BurstRecoveryTime 0.5}
		{BurstAccuracy 100 95 90 85 80}
		{SpreadXYRatio	1}
	}
	{AimingTolerance 20}

	("accuracy_mg_plane")
)