)


;// 7.62x25 Tokarev
(define "Tokarev"
	("human health" damage(53))
	("accuracy_Tokarev")
	("velocity" mps(488))
	{range 80 80}
	;// around 5.5 grams weight to 488-500 m/s
)
(define "Parabellum"
	("human health" damage(50))
	("accuracy_Para")
	("velocity" mps(395))
	{range 70 70}
	;// PP08 M.e round with around 6.35 grams weight to 395 m/s
)
(define "45ACP"
	("human health" damage(62))
	("accuracy_45acp")
	("velocity" mps(270))
	{range 60 60}
	;// slow round, strong up close, but undermined by larger dispersion at range
)


