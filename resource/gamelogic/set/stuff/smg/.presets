(include "\set\small_firearms_accuracy.inc")

(define "burst_short_slow"
	{burst
		{short 4 1}
		{long 6 2}
		{rangeKoef 0.4}
	}
	{FiringTimeoutDistanceFactor
		{0.25 0.55}	;20m, 1.1s
		{0.7 0.85}	;56m, 1.7s
		{1.0 0.95}	;80m, 1.9s
	}
)

(define "burst_short"
	{burst
		{short 3 1}
		{long 8 2}
		{rangeKoef 0.6}
	}
	{FiringTimeout 0.5 0.2}
	{FiringTimeoutDistanceFactor
        {0.25 1.0}    ;20m,
        {0.6 1.0}    ;56m,
        {1.0 0.5}    ;80m,
    }
)

(define "burst_medium"
	{burst
		{short 6 2}
		{long 9 2}
		{rangeKoef 0.6}
	}
	{FiringTimeout 0.7 0.2}
	{FiringTimeoutDistanceFactor
        {0.25 0.5}    ;20m,
        {0.7 0.85}    ;56m,
        {1.0 1.00}    ;80m,
    }
)

(define "burst_long"
	{burst
		{short 7 2}
		{long 12 2}
		{rangeKoef 0.6}
	}
	{FiringTimeout 0.9 0.2}
	{FiringTimeoutDistanceFactor
        {0.25 0.5}    ;20m,
        {0.7 0.85}    ;56m,
        {1.0 1.00}    ;80m,
    }
)

(define "burst_ppsh"	;// SMG when used as SAW
