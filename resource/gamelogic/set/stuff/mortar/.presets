
(include "\set\blast.inc")

(define "reload time"			;//reload time for magazine or shell
	{rechargeTime %seconds}
)

(define "fire rate"				;// rate of fire in rounds per minute 
	{recoveryTime (/ 60 %rpm)}
)


;// newly added
(define "armor health"
	{minimumDamageModifier (* 1.0 %damage)}
)


;/*--------------------------------------RANGES AND ACCURACY--------------------------------------*/


(define "light_mortar_range"	;// can throw over hill
	{spreading 
		{radiusTable {0 15} {100 20} {119.99 25} {120 100}}
	}

	{aimRange 100}
	{minRange 20}
	{maxRange 100}
	("reload time" seconds(3))

	{parameters "he"
		{projectileDamageTable {0 10}}
		("armor health" damage(100))
	}
	{parameters "he2"
		{projectileDamageTable {0 10}}
		("armor health" damage(100))
	}
	{parameters "sm"
		("reload time" seconds(3.0))
	}
	{parameters "wp"
		("reload time" seconds(3.0))
	}
)

(define "8_mortar_range"	;// 82mm mortar with 170 m/s MV
	{spreading
		{radiusTable {0 20} {120 25} {179.99 35} {180 100}}
		;//new2 table
		;{radiusTable {0 20} {120 25} {179.99 35} {180 100}}
	}
	;// the German 8cm has a range of 2.4 km irl
	;// but US, Soviet mortars have ~3 km (mod ~170m)
	
	{aimRange 180}
	{minRange 40}
	{maxRange 180}
	("reload time" seconds(3.7))

	{parameters "he"
		{projectileDamageTable {0 15}}
		("armor health" damage(150))
	}
	{parameters "he2"
		{projectileDamageTable {0 15}}
		("armor health" damage(150))
	}
	{parameters "sm"
		("reload time" seconds(4.2))
	}
	{parameters "wp"
		("reload time" seconds(4.2))
	}
)

