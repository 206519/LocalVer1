{curve "gun_std"}	;// Refers to ballistic.set


;// Find:
;// AP modifiers
;// Generic Slope Modifiers
;// APCR modifiers
;// Soviet modifiers


;// US 90 Cal


(define "zeroingP"
	{ZeroingAccuracy 0.8 0.65}
)

(define "zeroingG"
	{ZeroingAccuracy 0.7 0.5}
)



;/*============================== Speeds / Muzzle Velocity ==============================*/


(define "global velocity"
	{speed (* 1.00 %gv)}			;// Global muzzle velocity scale for all weapons in "gun" folder. is normally 0.75
)

(define "global velocity lowarc"
	{speed (* 1.00 %gv)}
)

(define "velocity"					;// used in gun file when muzzle velocity is same across all ammo types.
	("global velocity" gv(%mps))
)
(define "velocity m/s"				;// used in gun file when muzzle velocity varies across ammo types.

	("global velocity" gv(%he))		;// stops crash for on AI aim calculations

	{parameters "ap"		("global velocity" gv(%ap))}
	{parameters "apc"		("global velocity" gv(%ap))}
	{parameters "apche"		("global velocity" gv(%ap))}
	{parameters "aphe"		("global velocity" gv(%ap))}
	{parameters "apbc"		("global velocity" gv(%ap))}
	{parameters "apbche"	("global velocity" gv(%ap))}
	{parameters "apbche2"	("global velocity" gv(%ap))}
	{parameters "apcbc"		("global velocity" gv(%ap))}
	{parameters "apcbche"	("global velocity" gv(%ap))}
	{parameters "aphebc"	("global velocity" gv(%ap))}
	{parameters "aphebc2"	("global velocity" gv(%ap))}

	{parameters "apcr"		("global velocity" gv(%apcr))}
	{parameters "hvap"		("global velocity" gv(%apcr))}
	{parameters "apds"		("global velocity" gv(%apcr))}

	{parameters "he"		("global velocity" gv(%he))}
	{parameters "he2"		("global velocity" gv(%he))}
	{parameters "sm"		("global velocity" gv(%he))}
	{parameters "wp"		("global velocity" gv(%he))}

	{parameters "heat"		("global velocity" gv(%heat))}
	{parameters "heata"		("global velocity" gv(%heat))}
	{parameters "heatb"		("global velocity" gv(%heat))}
	{parameters "heatc"		("global velocity" gv(%heat))}
)

(define "velocity m/s lowarc"			;// used in gun file when muzzle velocity varies across ammo types.
	; uses lower arc for indirect (third the velocity)

	("global velocity" gv(%he))		;// stops crash for on AI aim calculations

	{parameters "ap"		("global velocity" gv(%ap))}
	{parameters "apc"		("global velocity" gv(%ap))}
	{parameters "apche"		("global velocity" gv(%ap))}
	{parameters "aphe"		("global velocity" gv(%ap))}
	{parameters "apbc"		("global velocity" gv(%ap))}
	{parameters "apbche"	("global velocity" gv(%ap))}
	{parameters "apbche2"	("global velocity" gv(%ap))}
	{parameters "apcbc"		("global velocity" gv(%ap))}
	{parameters "apcbche"	("global velocity" gv(%ap))}
	{parameters "aphebc"	("global velocity" gv(%ap))}
	{parameters "aphebc2"	("global velocity" gv(%ap))}

	{parameters "apcr"		("global velocity" gv(%apcr))}
	{parameters "hvap"		("global velocity" gv(%apcr))}
	{parameters "apds"		("global velocity" gv(%apcr))}

	{parameters "he"		("global velocity lowarc" gv(%he))}
	{parameters "he2"		("global velocity lowarc" gv(%he))}
	{parameters "sm"		("global velocity lowarc" gv(%he))}
	{parameters "wp"		("global velocity lowarc" gv(%he))}

	{parameters "heat"		("global velocity" gv(%heat))}
	{parameters "heata"		("global velocity" gv(%heat))}
	{parameters "heatb"		("global velocity" gv(%heat))}
	{parameters "heatc"		("global velocity" gv(%heat))}
)


;/*============================== Rate of Fire ==============================*/


(define "fire rate"			;//rate of fire in rounds per minute 
	{recoveryTime (/ 60 %rpm)}
)

(define "reload time"		;//reload time for magazine or shell
	{rechargeTime %seconds}
)


;/*============================== Damages ==============================*/

(define "penetration_long"
	{parameters "%shell" ;// for units with higher range than 205, polynomial curve to simulate closer range engagements
		{projectileDamageTable {10 (+ %a (+ 0.3 (/ (- %a %b) 4.4)))} {40 %a} {120 %b} {190 %c} {250 %d} {305 %e} {500 (- %e (* 5 (- %a %e)))} }
		{range %range %range}
		;1.49
		
		;{projectileDamageTable {10 (+ %a (+ 0.3 (/ (- %a %b) 4.4)))} {60 %a} {155 %b} {240 %c} {315 %d} {405 %e} {500 (- %e (* 5 (- %a %e)))} }
	}
)
(define "penetration_medium"
	{parameters "%shell" ;// for units with higher range than 155 and lower 205, polynomial curve to simulate closer range engagements
		{projectileDamageTable {10 (+ %a (+ 0.3 (/ (- %a %b) 4.4)))} {40 %a} {120 %b} {190 %c} {250 %d} {305 %e} {500 (- %e (* 5 (- %a %e)))} }
		{range %range %range}
	}
)
(define "penetration_short"
	{parameters "%shell" ;// for units with higher range than 100 and lower than 155, polynomial curve to simulate closer range engagements
		{projectileDamageTable {10 (+ %a (+ 0.3 (/ (- %a %b) 4.4)))} {40 %a} {120 %b} {190 %c} {250 %d} {305 %e} {500 (- %e (* 5 (- %a %e)))} }
		{range %range %range}
	}
)
(define "penetration"  ;// penetration drop curve with decreasing penetration after 250m (2km IRL, 1/8th ish Scale)
	{projectileDamageTable {10 (+ %a (+ 1.3 (/ (- %a %b) 4.4)))} {30 %a} {100 %b} {155 %c} {205 %d} {250 %e} {500 (- %e (* 5 (- %a %e)))}} ;// shell penetration over distance
	;{projectileDamageTable {60 %a} {125 %b} {190 %c} {250 %d} {305 %e}}
	;reducing dropoff
)

(define "armor health"

	{minimumDamageModifier (* 1.25 %damage)} ;// In case only generic value is called

	{parameters "ap" 		{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "apc" 		{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "apche" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "aphe" 		{minimumDamageModifier (* 1.00 %damage)}}
	
	{parameters "apbc" 		{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "apcbc" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "apcbche" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "apcbche2" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "aphebc" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "aphebc2" 	{minimumDamageModifier (* 1.00 %damage)}}
	
	{parameters "apcr" 		{minimumDamageModifier (* 1.00 %damage)}} ;// was 0.75, but it isn't realistic
	{parameters "hvap" 		{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "apds" 		{minimumDamageModifier (* 1.00 %damage)}}
	
	;// for RDX filler HEAT
	{parameters "heat" 		{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "heata" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "heatb" 	{minimumDamageModifier (* 1.00 %damage)}}
	{parameters "heatc" 	{minimumDamageModifier (* 1.00 %damage)}}
	;// HE, WP, SM not included as they have no penetration power modelled.
)

; // Damage logic for AP-type shells with HE filler. Implemented a cubic equation to interpolate. Avoid touching the numbers (very sensitive!).
(define "armor health custom" ;
	{parameters "%shell" 	
		{minimumDamageModifier (- (+ 1 (+ %damage (+ (* 0.25 %filler ) (* 0.0000000055 (* %filler (* %filler %filler))))))  (* 0.000045 (* %filler %filler)))} 
		; //Filler defined in grams of TNT
		
	}
)
(define "human health"		;// Damage to human health
	{healthDamage (* 1 %damage)}
)



;/*============================== Accuracies ==============================*/

(define "accuracy_indirect" 	;// for indirect units with more than 200m range
	("curve_indirect"
		r1(%r1)						;// direct fire accuracy
		r2(%r2)						;// indirect fire accuracy
		rmax(%rmax)					;// max range indirect fire accuracy
		range_ap(%range_ap)
		range_he(%range_he)
		range_heat(%range_heat)
		falloff(0.05)
		r0(1.350)					;// global accuracy indirect, was 1.45
		r01(0.43)					;// global accuracy direct
		  ap50(1.4)   ap100(2.75)   ap140(4.00)   ap200(6.30)
		heat50(1.4) heat100(3.00) heat140(4.25) heat200(8.00)
		 he125(0.7)
	)
)

;// HE had ? 2.5 (250) but uniquely, multiplied by r2 rglobal (1.45), 
;//		so as an example, 9 x 1.45 x 0.4 (he125) = 4.32 at 125 
;//		and at 250m, 9 x 1.45 x 1.25 (vanilla has 1.85) = 16.3125

(define "curve_indirect"
	{parameters "ap"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "ap2"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apc"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apche"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "aphe"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apbc"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apbche"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apcbc"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apcbche"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apcbche2"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "aphebc"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "aphebc2"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apcr"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apcr2"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "hvap"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "apds"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %ap50 (* %r1 %r01))} {100 (* %ap100 (* %r1 %r01))} {140 (* %ap140 (* %r1 %r01))} { %range_ap (* (+ (* (/ (- %range_ap 140) (- 200 140)) (- %ap200 %ap140)) %ap140) (* %r1 %r01))} {(+ %range_ap 10) 10}}
		}
	}
	{parameters "he"
		{spreading
			{radiusTable {0 0} {(- %range_ap 10) (* %he125 (* 0.5 (* %r2 %r0)))} {(+ %range_ap 50) (* 1.85 (* %r2 %r0))} {(- %range_he 0.1) (* %rmax %r0)} {(+ %range_he 10) 60}} ; // Anti-farshoot, accuracy goes haywire past max range
		}
	}
	{parameters "he2"
		{spreading
			{radiusTable {0 0} {(- %range_ap 10) (* %he125 (* 0.5 (* %r2 %r0)))} {(+ %range_ap 50) (* 1.85 (* %r2 %r0))} {(- %range_he 0.1) (* %rmax %r0)} {(+ %range_he 10) 60}} ; // Anti-farshoot, accuracy goes haywire past max range
		}
	}
	{parameters "sm"
		{spreading
			{radiusTable {0 0} {160 (* %he125 (* 0.5 (* %r2 %r0)))} {250 (* 1.5 (* %r2 %r0))} {%range_he (* %rmax %r0)} {(* %range_he 10) 60}}
		}
	}
	{parameters "wp"
		{spreading
			{radiusTable {0 0} {160 (* %he125 (* 0.5 (* %r2 %r0)))} {250 (* 1.5 (* %r2 %r0))} {%range_he (* %rmax %r0)} {(* %range_he 10) 60}}
		}
	}
	{parameters "ic"
		{spreading
			{radiusTable {0 0} {160 (* %he125 (* 0.5 (* %r2 %r0)))} {250 (* 1.5 (* %r2 %r0))} {(- %range_he 0.1) (* %rmax %r0)} {(+ %range_he 10) 60}} ; // Anti-farshoot, accuracy goes haywire past max range
		}
	}
	{parameters "heat"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %heat50 (* %r1 %r01))} {100 (* %heat100 (* %r1 %r01))} {140 (* %heat140 (* %r1 %r01))} { %range_heat (* (+ (* (/ (- %range_heat 140) (- 200 140)) (- %heat200 %heat140)) %heat140) (* %r1 %r01))} {(+ %range_heat 10) 10}}
		}
		{FalloffMeter %range_heat}
		{FalloffStrength %falloff}
	}
	{parameters "heata"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %heat50 (* %r1 %r01))} {100 (* %heat100 (* %r1 %r01))} {140 (* %heat140 (* %r1 %r01))} { %range_heat (* (+ (* (/ (- %range_heat 140) (- 200 140)) (- %heat200 %heat140)) %heat140) (* %r1 %r01))} {(+ %range_heat 10) 10}}
		}
		{FalloffMeter %range_heat}
		{FalloffStrength %falloff}
	}
	{parameters "heatb"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %heat50 (* %r1 %r01))} {100 (* %heat100 (* %r1 %r01))} {140 (* %heat140 (* %r1 %r01))} { %range_heat (* (+ (* (/ (- %range_heat 140) (- 200 140)) (- %heat200 %heat140)) %heat140) (* %r1 %r01))} {(+ %range_heat 10) 10}}
		}
		{FalloffMeter %range_heat}
		{FalloffStrength %falloff}
	}
	{parameters "heatc"
		("standard_firing_arc")
		{spreading
			{radiusTable {0 0} {50 (* %heat50 (* %r1 %r01))} {100 (* %heat100 (* %r1 %r01))} {140 (* %heat140 (* %r1 %r01))} { %range_heat (* (+ (* (/ (- %range_heat 140) (- 200 140)) (- %heat200 %heat140)) %heat140) (* %r1 %r01))} {(+ %range_heat 10) 10}}
		}
		{FalloffMeter %range_heat}
		{FalloffStrength %falloff}
	}
)


(define "accuracy_direct" ;// Accuracy for direct-fire weaponry
	("curve_direct"
		r1(%r1)
		range_ap(%range_ap)
		range_he(%range_he)
		range_heat(%range_heat)
		falloff(0.15)
		r0(0.43) 								; // global accuracy
		apbc50(1.30) apbc100(2.75) apbc140(4.00) apbc200(6.00)
		 apc50(1.30)  apc100(3.00)  apc140(4.35)  apc200(6.50)
		  ap50(1.30)   ap100(3.00)   ap140(4.35)   ap200(6.50)
		  he50(1.50)   he100(3.00)   he140(4.50)   he200(7.50)
		heat50(1.50) heat100(3.00) heat140(4.50) heat200(7.50)
		apcr50(1.20) apcr100(2.50) apcr140(3.75) apcr200(5.50)
		hvap50(1.30) hvap100(2.75) hvap140(4.00) hvap200(5.50)
		apds50(1.30) apds100(3.50) apds140(6.00) apds200(8.00)
	)
	;// test1; 1.5, 3.0, 4.2, 6.3 [APBC]
	;// test2; 1.25, 2.75, 4.1, 6.4
	;// test1 HE; 1.4, 
)
(define "accuracy_direct_arrowhead" ;// accuracy for 'arrow' APCR
	("curve_direct"
		r1(%r1)
		range_ap(%range_ap)
		range_he(%range_he)
		range_heat(%range_heat)
		falloff(0.15)
		r0(0.43) 								; // global accuracy
		apbc50(1.30) apbc100(2.75) apbc140(4.00) apbc200(6.00)
		 apc50(1.30)  apc100(3.00)  apc140(4.35)  apc200(6.50)
		  ap50(1.30)   ap100(3.00)   ap140(4.35)   ap200(6.50)
		  he50(1.50)   he100(3.00)   he140(4.50)   he200(7.50)
		heat50(1.50) heat100(3.00) heat140(4.50) heat200(7.50)
		apcr50(1.20) apcr100(2.50) apcr140(3.75) apcr200(6.50)
		hvap50(1.30) hvap100(2.75) hvap140(4.00) hvap200(5.50)
		apds50(1.30) apds100(3.50) apds140(6.00) apds200(8.00)
	)
)

(define "accuracy_direct_auto" ;// Accuracy for direct-fire weaponry, autocannons
	("curve_direct"
		r1(%r1)
		range_ap(%range_ap)
		range_he(%range_he)
		range_heat(%range_heat)
		falloff(0.15)
		r0(0.55) 								; // global accuracy
		apbc50(1.30) apbc100(2.75) apbc140(4.00) apbc200(6.00)
		 apc50(1.30)  apc100(3.00)  apc140(4.35)  apc200(6.50)
		  ap50(1.30)   ap100(3.00)   ap140(4.35)   ap200(6.50)
		  he50(1.50)   he100(3.00)   he140(4.50)   he200(7.50)
		heat50(1.50) heat100(3.00) heat140(4.50) heat200(7.50)
		apcr50(1.20) apcr100(2.50) apcr140(3.75) apcr200(5.50)
		hvap50(1.25) hvap100(2.50) hvap140(3.50) hvap200(5.50)
		apds50(1.30) apds100(3.50) apds140(6.00) apds200(8.00)
	)
)
