(define "t33_slmod" ;	use for 90mm M77 & T33
	;// new table with K2100
	{overmatchFixed
		{0		1.0		}
		{20		1.098	}
		{30		1.223	}	;// 4.8" at MV
		{45		1.472	}	;// 
		{55		1.813	}	;// dent 76.2 at 739 m/s
		{60		2.657	}	;// dent 50.8 at 731.8 m/s
		{65		3.339	}
		{70		4.491	}
		{75		6.634	}
		{80		11.6	}
		{85		30.450	}
		{90		99.0000	}
	}
	;// overall modifier ~1.4
	;// Dent at 732 m/s taken as penetration
	;// Dent at 739 m/s taken as penetration
)

(define "m82_slmod" ;for M82 APC
	;// performance is estimated by K2050
	{overmatchCalibre
		{0		1.0			0.00	}	;// estimated performance
		{10		1.04		0.005	}	;// 790 on 6" @10
		{20		1.205		0.027	}	;// 
		{25		1.385		0.027	}	;// 82mm @25 for 668 m/s
		{30		1.419		0.078	}	;//	3" at 542/584 m/s (US), 82mm @30 for <668
		{40		1.472		0.105	}
		{45		1.907		0.088	}	;// 2.5" @45 for 632 m/s
		{50		2.221		0.087	}	;// 2.5" at 727 and 3" at 790
		{55		2.657		0.092	}	;// (470m) 795 m/s vs 2.5"
		{60		3.026		0.001	}	;// 2.25" at 787 m/s, or 2.5" at 865 m/s dent
		{65		3.868		0.001	}
		{70		5.268		0.019	}
		{75		8.115		0.455	}
		{80		16.61		0.766	}
		{85		56.45		0.766	}
		{90		99.0000		0.00000	}
	}
	;// the specified velocities are Army Limit
	;// overmatch modifier is currently neglected 
	
	;// The real range table has an incredibly low coefficient of drag of 0.28. 
	;// That doesn't match M62 CFD and is unreasonably low (other designs are 0.36-0.38).
	;// BR-365 (boat tailed) is 0.34, which is around the best for this velocity
)

(define "BR271_41" ;	use for 57 with K2250 on 45RC prewar body
	{overmatchCalibre
		{0		1.0		}
		{10		1.017	}		
		{20		1.071	}
		{30		1.197	}	;// at 977, success (base through 100%) on 90, and 80 at 872, which is slightly lower than Pak 40 by around 7mm in the same conditions
		{45		1.472	}	;// 80 at 977, 75 at 400, 70 at 700	
		{50		1.564	}
		{55		2.003	}
		{60		2.256	}	;// at 977 m/s success (base through, 100%) on 50mm @60 is possible, which is better than pak 40 (success at 768 m/s) by about 100m
		{65		2.79	}	
		{72		3.639	}	
		{75		5.417	}	
		{80		8.921	}
		{85		14.644	}
		{90		99.0000	}
	}
	;// this matches for the base through success at K2350, we take as 2250 for the (assumed) ~45RC body
	;// ~x1.1 vel
)

