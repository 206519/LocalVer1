	; between %range_he and 20m past, accuracy is approx. rmax to prevent farshootfagging
	; goes from max to 10m past max to rmax, then to 10m past to 20m past to normal again
	;
	; back to normal (bit less than 250m in normal indirect)
	;
	;
	{parameters "he"
		{spreading
			{radiusTable
				{0 0}
				{50 (* %he50 (* %r1 %r0))}
				{100 (* %he100 (* %r1 %r0))}
				{140 (* %he140 (* %r1 %r0))}
				{ (- %range_he 0.01) (* (+ (* (/ (- %range_he 140) (- 200 140)) (- %he200 %he140)) %he140) (* %r1 %r0))}
				{(+ %range_he 10) (* 1.0 (* %r1i %r0i))}
				{(- %range_hei 0.01) (* %rmax %r0i)}
				{(+ %range_hei 1) 60}
			}
		}
		{range %range_hei %range_hei}
		{FalloffMeter %range_hei}
		{FalloffStrength %falloff}
	}
	{parameters "he2"
		{spreading
			{radiusTable 
				{0 0} 
				{50 (* %he50 (* %r1 %r0))} 
				{100 (* %he100 (* %r1 %r0))} 
				{140 (* %he140 (* %r1 %r0))} 
				{ (- %range_he 0.01) (* (+ (* (/ (- %range_he 140) (- 200 140)) (- %he200 %he140)) %he140) (* %r1 %r0))}
				{(+ %range_he 10) (* 1.0 (* %r1i %r0i))}
				{(- %range_hei 0.01) (* %rmax %r0i)}
				{(+ %range_hei 1) 60}
			}
		}
		{range %range_hei %range_hei}
		{FalloffMeter %range_hei}
		{FalloffStrength %falloff}
	}
	{parameters "sm"
		{spreading
			{radiusTable
				{0 0} 
				{50 (* %he50 (* %r1 %r0))} 
				{100 (* %he100 (* %r1 %r0))} 
				{140 (* %he140 (* %r1 %r0))} 
				{ (- %range_he 0.01) (* (+ (* (/ (- %range_he 140) (- 200 140)) (- %he200 %he140)) %he140) (* %r1 %r0))}
				{(+ %range_he 10) (* 1.0 (* %r1i %r0i))}
				{(- %range_hei 0.01) (* %rmax %r0i)}
				{(+ %range_hei 1) 60}
			}
		}
		{range %range_hei %range_hei}
		{FalloffMeter %range_he}
		{FalloffStrength %falloff}
	}
	{parameters "wp"
		{spreading
			{radiusTable
				{0 0} 
				{50 (* %he50 (* %r1 %r0))} 
				{100 (* %he100 (* %r1 %r0))} 
				{140 (* %he140 (* %r1 %r0))} 
				{ (- %range_he 0.01) (* (+ (* (/ (- %range_he 140) (- 200 140)) (- %he200 %he140)) %he140) (* %r1 %r0))}
				{(+ %range_he 10) (* 1.5 (* %r1i %r0i))}
				{(- %range_hei 0.01) (* %rmax %r0i)}
				{(+ %range_hei 1) 60}
			}
		}
		{range %range_hei %range_hei}
