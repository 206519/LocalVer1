		{range 170 170}
	)
	{unlimitedRangeTPC 0}   ;// restrict range in TPC/FPC

	{parameters "he"
		{range 170 170}
	}
	
	("curved_firing_arc")

	{parameters "he2" ;// stielgranate 42
		("reload time" seconds(30))
		{speed 100}
		{gravity 3}
		{range 100 100}
		{spreading
			{radiusTable {0 0} {50 7} {100 12} {105 100}}
		}
	}
