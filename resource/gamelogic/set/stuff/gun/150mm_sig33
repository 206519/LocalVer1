	("range_160_howitzer")
	{calibre 150}

	("reload time" seconds(20))

	("velocity m/s" ap(1) apcr(1) he(240) heat(240))
	("armor health" damage(450))
	("85-155_slope_multipliers")

	; Gr.39 Hl/A

	("penetration_medium" shell(heat) range(160) a(185) b(185) c(185) d(185) e(185))
	("accuracy_spg" r1(2.4) range_ap(150) range_he(170) range_heat(160))

	(mod not "mp"
