{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "panzer4j" "medium" "vision_lev04" "muzzle_75mm_76mm_sides" "shield" "smoke" "nvw"}
	{extension "panzer4j_fin.mdl"}
	(include  "panzer4j_fin.ext")
	{PatherId "panzer4h"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	("crew_5_human_extended")
	;("gunner_visible")

	{boarder
		{anm "driver"
			{forward {begin "board_pz4_driver"} {end "pose_mgun_pz6"} {base "open_driver"}}
			{reverse {end "board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_cromwell"} {end "pose_mgun_pz6"}}
			{reverse {end "board_cromwell" -1}}
		}
		{anm "right"
			{forward {begin "board_cromwell"} {end "pose_mgun_pz6"}}
			{reverse {end "board_cromwell" -1}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "shield" {on}}

	{##extender "smokescreen" ;// sources say that these were not installed in the vehicles delivered to the Finns. 
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		;{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_75_l43 apcbche" 31} 	; 87 rounds
			{item "bulletger_75_l43 he" 43}
			{item "bulletger_75_l43 apcr" 2}
			{item "bulletger_75_l43 heatb" 10}
			{item "ammo mgun_ger belt" 2850}		; 21 belts (150 rounds each)
			;{item "mg34_drum" filled {user "mgun"}}
			{item "geballteladung_3kg" 1}
			;{item "nbks grenade" 6}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk40_l48" filling "bulletger_75_l43 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 26000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.45))
		("mobility_spearhead"
			speed(38)			;Max speed when fully accelerated on road, km/h.
			reverse(5.2)		;Max speed in reverse on road, km/h.
			mass(26)			;Mass, in metric tons.
			power(300) 			;Engine Power
			contact(3.52)		;Track-ground contact length, in m
			wheelbase(2.46)		;Distance between center of left and right side roadwheels, in m
			pressure(0.89)		;Ground pressure on road, in kg/cm^2
			coeff_accel(4)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(4)	;Modifier for steering, (0,10]
			coeff_steer_eff(5)	;Modifier for steering, (0,10]
			fuel(680) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(210) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 5}
	}
	{bone "turret"
		("turret_medium" power_traverse(0)) ;// manual
	}
}