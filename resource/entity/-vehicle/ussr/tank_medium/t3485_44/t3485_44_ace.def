{game_entity
	(include "t3485_44.inc")
	{extender "inventory"
		{box
			{item "bulletrus_85 aphebc" 19}		;56 rounds historical loadout ;60 rounds for late models
			{item "bulletrus_85 he" 36}
			{item "ammo mgun_rus dt api" 2394}		;40 drums
			{item "satchel_charge_rus" 1}
			;// "The Soviets had also AP-T and APCR-T rounds for this gun, but apparently there were none in Finnish use." (captured)
			;// 
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "85mm_zis53" filling "bulletrus_85 aphebc" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.25)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt api" 63}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "dt" filling "ammo mgun_rus dt api" 63}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	}
	
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7))
		("mobility_spearhead"
			speed(55)			;Max speed when fully accelerated on road, km/h.
			reverse(8.12)		;Max speed in reverse on road, km/h.
			mass(32.0)			;Mass, in metric tons.
			power(500) 			;Engine Power
			contact(3.73)		;Track-ground contact length, in m
			wheelbase(2.45)		;Distance between center of left and right side roadwheels, in m
			pressure(0.87)		;Ground pressure on road, in kg/cm^2
			coeff_accel(6.5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5.5)	;Modifier for steering, (0,10]
			coeff_steer_eff(3.5)	;Modifier for steering, (0,10]
			fuel(545)	 		;Fuel capacity in Litres.
			type(diesel)		;Fuel type. (diesel OR fuel)
			range(200) 			;Range in km, off-road.
			maxslope(70)		;Max slope (tan(gradient in degrees) * 100)
		)
	}
}