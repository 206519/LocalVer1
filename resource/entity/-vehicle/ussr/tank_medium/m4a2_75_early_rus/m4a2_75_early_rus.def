{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "m4a2_75_early" "medium" "vision_lev04" "muzzle_75mm_76mm" "muzzle_hmg_m2hb" "diesel"}
	{extension "m4a2_75_early_rus.mdl"}
	(include  "m4a2_75_early_rus.ext")
	{PatherId "m4_75_vvss"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	("crew_5_human_extended2")
	("gunner_visible2")

	{sensor
		{visor "main"
			{vision "tank_periM4A1"}
		}
		{Visor "driver"
			{vision "tank_driver_Sherman"}
		}
		{visor "around"
			{vision "tank_cupola_Sherman_split"}
		}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_m4_driver"} {end "seat_m4_gunner"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver"}}
		}
		{anm "co_driver"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"} {base "open_co_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_co_driver"}}
		}
		{anm "left"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor2"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit7) animation(armor2))

	{extender "inventory"
		{box
			{item "ammo bulletusa_75x350 apcbche" 38}	; 97 rounds ;40/60% AP/HE
			{item "ammo bulletusa_75x350 he" 59}
			{item "ammo mgun_usa belt" 4250}			; 19 belts (250 rounds each)
			{item "ammo hmgun_usa ap" 500}				; 6 boxes (100 rounds each)
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_m3_m38a2" filling "ammo bulletusa_75x350 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3)
				dispersion(0.3)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "browning_m19a4_tank" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "browning_m19a4_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{weapon "browning_m2" filling "hmgun_usa ap" 100}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 31842}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.53))
		("mobility_spearhead"
			speed(48.28)		;Max speed when fully accelerated on road, km/h.
			reverse(6.14)		;Max speed in reverse on road, km/h.
			mass(31.842)		;Mass, in metric tons.
			power(310) 			;Engine Power	;// 25% power losses after a few hours of operation
			contact(3.7338)		;Track-ground contact length, in m
			wheelbase(2.11)		;Distance between center of left and right side roadwheels, in m
			pressure(1.01)		;Ground pressure on road, in kg/cm^2
			coeff_accel(6)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(1)	;Modifier for steering, (0,10]
			coeff_steer_eff(6)	;Modifier for acceleration, (0,10]
			fuel(560.241) 		;Fuel capacity in Litres.
			type(diesel)		;Fuel type. (diesel OR fuel)
			range(140) 			;Range in km, off-road.
			maxslope(47)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 25}
		{speed2 5}
	}
	{bone "turret"
		("turret_medium" power_traverse(24))
	}
	{bone "cupola_ring"
		{speed2 50}
	}
	{bone "mgun_a_rot1"
		{limits -10 10}
		{speed2 60}
	}
	{bone "mgun_a_rot2"
		{limits -10 65}
		{speed2 60}
	}
}