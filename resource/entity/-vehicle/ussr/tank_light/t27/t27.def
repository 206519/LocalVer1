{game_entity
	(include "/properties/tank_unarmed.ext")
	
	(include "/properties/selection/vehicle.inc" scale(0.7))
	{props "light" "vision_lev02" "tractor" "tractor_medium" "detect_tank_mg"}
	{extension "t27.mdl"}
	(include "t27.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_bullet"}
	{patherId "t27"}
	{collider "tank.light"}

	("crew_2_human")

	{sensor
		{visor "around"
			{vision "tank_main_mg"}
			{bone "visor1"}
		}
	}

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "ammo mgun_rus dt" 1701}		;28 drums
			{item "dt" filling "ammo mgun_rus dt" 63 {user "mgun"}}
		}
	}

	{Weaponry
		{place "mgun"
			{type "hull"}
			{LinkBone "mgun"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{rotate}
		}
	}

	{mass 2700}
	{Chassis "track"
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.57))
		("mobility_spearhead"
			speed(40)			;Max speed when fully accelerated on road, km/h.
			reverse(13)			;Max speed in reverse on road, km/h.
			mass(2.7)			;Mass, in metric tons.
			power(50) 			;Engine Power
			contact(2.97)		;Track-ground contact length, in m
			wheelbase(2.0)		;Distance between center of left and right side roadwheels, in m
			pressure(0.5)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(5)	;Modifier for steering, (0,10]
			fuel(42) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(60) 			;Range in km, off-road.
			maxslope(62)		;Max slope (tan(gradient in degrees) * 100)
		)
	}
}