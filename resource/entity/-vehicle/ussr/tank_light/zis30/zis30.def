{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "td" "light" "turret" "shell_eject" "vision_lev02" "muzzle_50mm_57mm" "detect_td_light"}
	{Extension "zis30.mdl"}
	(include "zis30.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_medium"}
	{patherId "zis30"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_tank_left"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "left"
			{forward {begin "board_tank_left"} {end "pose_pak40_gunlayer" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "pose_pak40_charger" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}

	{boarder
		{door "emit0"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}

	{sensor
		{visor "around"
			{vision "vehicle_around"}
		}
	}

	("crew_human" place(gunner3)  door(emit1)  visor(driver))
	("crew_human_visible" place(gunner)	 door(emit2)  visor(main))
	("crew_human_visible" place(commander)  door(emit3)  visor(around))

	{extender "inventory"
		{box
			{item "bulletrus_57 aphe" 14}		;20 rounds 
			{item "bulletrus_57 he" 5}
			{item "ammo mgun_rus dt" 567}		;10 drums
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "57mm_zis2_2" filling "bulletrus_57 aphe" 1}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic_td"
				zeroing(5.0)
				dispersion(0.2)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{rotate}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 4000}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.3))
		("mobility_spearhead"
			speed(30)			;Max speed when fully accelerated on road, km/h.
			reverse(6)			;Max speed in reverse on road, km/h.
			mass(4.0)			;Mass, in metric tons.
			power(50) 			;Engine Power
			contact(2.97)		;Track-ground contact length, in m
			wheelbase(2.0)		;Distance between center of left and right side roadwheels, in m
			pressure(0.6)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(6)		;Modifier for steering, (0,10]
			coeff_steer_eff(4)		;Modifier for steering, (0,10]
			fuel(120) 		;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(120) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -4 22}
		{speed2 8}
	}
	{bone "turret"
		{limits -30 30}
		{speed2 8}
	}
}