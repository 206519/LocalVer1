{game_entity
	(include "/properties/tank.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "muzzle_37mm_47mm" "tractor" "tractor_medium" "detect_tank_light"}
	{extension "t70m.mdl"}
	(include "t70m.ext")
	{PatherID "t70"}
	{collider "tank.light"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	("crew_2_human_extended")
	
	{sensor
		{visor "main"
			{vision "tank_range_TMFD"}
		}
		{Visor "driver"
			{vision "tank_driver_T70"}
		}
		{Visor "around"
			{vision "none"}
		}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_t26_driver"} {end "pose_t26_driver"} {base "open_driver"}}
			{reverse {end "board_t26_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_tank_left"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "seat_m7_com"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor1"
			{forward {begin "board_LowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat0) bone(seat00) door(emit3) animation(armor1))
	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))

	{extender "inventory"
		{box
			{item "bulletrus_45 aphebc" 25}		;90 rounds
			{item "bulletrus_45 apcr" 6}
			{item "bulletrus_45 he2" 58}
			{item "ammo mgun_rus dt" 882}		;15 drums
			{item "satchel_charge_rus" 1}
		}
	}
	
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "45mm_20k_1" filling "bulletrus_45 aphebc" 1}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}
	
	{mass 9800}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.17) len(0.6))
		("mobility_spearhead"
			speed(45)			;Max speed when fully accelerated on road, km/h.
			reverse(5.9)			;Max speed in reverse on road, km/h.
			mass(9.8)			;Mass, in metric tons.
			power(120) 			;Engine Power - power at ~3400 rpm
			contact(3.12)		;Track-ground contact length, in m
			wheelbase(2.0)		;Distance between center of left and right side roadwheels, in m
			pressure(0.70)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(5)	;Modifier for steering, (0,10]
			fuel(440) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(180) 			;Range in km, off-road.
			maxslope(67)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -6 20}
		{speed2 5}
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
}