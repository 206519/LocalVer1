{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1))
	{props "light" "vision_lev03" "muzzle_20mm_25mm_auto" "amphibia" "tractor" "tractor_medium" "detect_tank_light"}
	{extension "t30.mdl"}
	(include "t30.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_zenite"}
	{PatherID "t40"}
	{collider "tank.light"}
	("tank_light_tier1")


	("crew_2_human")
	
	{sensor
		{visor "main"
			{vision "tank_range_TMFD"}
		}
		{Visor "driver"
			{vision "tank_driver_T26"}
		}
		{Visor "around"
			{vision "tank_aroundBad"}
		}
	}

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward {begin "board_LowArmor"} {end "seat_armor"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_LowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat0) bone(seat00) door(emit3)  animation(armor1))
	("seat_human" place(seat1) bone(seat01) door(emit4)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5)  animation(armor))

	{extender "inventory"
		{box
            {item "bulletrus_20_auto ap" 348}	;13 belts
			{item "bulletrus_20_auto he" 348}
			{item "ammo mgun_rus dt" 882}		;15 drums
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_tns" filling "bulletrus_20_auto ap" 58}
			{charger "gunner"}
			("abm_dymamic_autocannon"
				zeroing(2)
				dispersion(0.15)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight5"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 6100}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.6))
		("mobility_spearhead"
			speed(45)			;Max speed when fully accelerated on road, km/h.
			reverse(5.9)		;Max speed in reverse on road, km/h.
			mass(6.1)			;Mass, in metric tons.
			power(91) 			;Engine Power
			contact(2.36)		;Track-ground contact length, in m
			wheelbase(2.1)		;Distance between center of left and right side roadwheels, in m
			pressure(0.69)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(5)	;Modifier for steering, (0,10]
			fuel(207) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(185) 			;Range in km, off-road.
			maxslope(62)		;Max slope (tan(gradient in degrees) * 100)
		)
		{switch
			{exitFromWater}
			{terrain not "water" "deep_water"}
		}
	}

	{chassis "water"
		("chassis_defaults")
		(mod not "mp" {ignorePatherBounds})
		{waterline 0.9}
		{switch
			{terrain "water" "deep_water"}
		}
	}

	{bone "gun_rot"
		{limits -5 20}
		{speed2 20}
	}
	{bone "turret"
		{speed2 17}
	}
}