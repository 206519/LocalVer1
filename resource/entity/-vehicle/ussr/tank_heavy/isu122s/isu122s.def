{game_entity
	(include "/properties/tank_assaultgun.ext")
	(include "/properties/selection/vehicle_big.inc" scale(0.9))
	{props "td" "heavy" "-turret" "vision_lev05" "muzzle_122mm_128mm_sides" "muzzle_hmg_dshk" "diesel" "detect_spg"}
	{extension "isu122s.mdl"}
	(include "isu122s.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_spg"}
	{PatherId "is"}
	{collider "tank.heavy"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_220"}
		}
	}

	{extender "shield" {on}}

	("crew_5_human_2")
	("gunner_visible")

	{boarder
		{anm "driver"
			{forward {begin "board_kv2_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "left"
			{forward {begin "board_Kv-85"} {end "seat_isu152_gunner2"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_Kv-85"} {end "seat_isu152_gunner2"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "seat_armor"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "seat_armor"}}
			{reverse {end "emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "inventory"
		{box
			{item "bulletrus_122_l48 aphebc" 19}		;30 rounds
			{item "bulletrus_122_l48 he" 10}
			{item "satchel_charge_rus" 1}
			{item "ammo hmgun_rus" 200}					;5 drum boxes
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "122mm_d25s" filling "bulletrus_122_l48 aphebc" 1}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.20)
			)
		}
		{place "mgun"
			{type "aa"}
			{weapon "dshk" filled}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun_bone"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 46000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.90))
		("mobility_spearhead"
			speed(37.7)			;Max speed when fully accelerated on road, km/h.
			reverse(17.96)		;Max speed in reverse on road, km/h.
			mass(46)			;Mass, in metric tons.
			power(520) 			;Engine Power
			contact(4.36)		;Track-ground contact length, in m
			wheelbase(2.41)		;Distance between center of left and right side roadwheels, in m
			pressure(0.83)		;Ground pressure on road, in kg/cm^2
			coeff_accel(6)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering rate, (0,10]
			coeff_steer_eff(5)	;Modifier for steering efficiency, (0,10]
			fuel(790) 			;Fuel capacity in Litres.
			type(diesel)		;Fuel type. (diesel OR fuel)
			range(160) 			;Range in km, off-road.
			maxslope(73)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -3 20}
		{speed2 3}
	}
	{bone "turret"
		{limits -3 7}
		{speed2 3}
	}
}