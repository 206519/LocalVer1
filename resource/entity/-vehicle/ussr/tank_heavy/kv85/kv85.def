{game_entity
	(include "/properties/tank.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_75mm_76mm" "diesel" "detect_tank_heavy"}
	{extension "kv85.mdl"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_medium"}
	(include "kv85.ext")
	{PatherId "kv1s"}
	{collider "tank.heavy"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}
	{sensor
		{visor "main"
			{vision "tank_range_TMFD"}
		}
		{visor "driver"
			{vision "tank_driver_KV"}
		}
		{visor "back"
			{vision "tank_back"}
			{bone "foresight6"}
		}
		{visor "around"
			{vision "tank_cupola_KV1S"}
		}
	}

	("crew_4_human")
	;("commander_visible")
	("crew_human" place(charger) door(emit1) door2(emit2) visor(back))

	{boarder
		{anm "driver"
			{forward {begin "board_kv2_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "left"
			{forward {begin "board_Kv-85"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_Kv-85"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} 	{end "seat_armor"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "seat_armor"}}
			{reverse {end "emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))
	("seat_human" place(seat5) bone(seat05) door(emit7)  animation(armor))
	("seat_human" place(seat6) bone(seat06) door(emit8)  animation(armor1))
	("seat_human" place(seat7) bone(seat07) door(emit9)  animation(armor))

	{extender "inventory"
		{box
			{item "bulletrus_85 aphe" 23}		;70 rounds
			{item "bulletrus_85 he" 46}
			{item "ammo mgun_rus dt" 2394}		;40 drums
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "85mm_d5t" filling "bulletrus_85 aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_td"
				zeroing(5.0)
				dispersion(0.2)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun3"
			{type "rear"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight6"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 45282}
	{Chassis
	;// https://www.tankarchives.ca/2018/12/the-kvs-last-bow.html
		("tank_trace" fx("tracks_big") step(0.47) len(0.79))
		("mobility_spearhead"
			speed(45)			;Max speed when fully accelerated on road, km/h.
			reverse(16.6)			;Max speed in reverse on road, km/h.
			mass(46)			;Mass, in metric tons.
			power(600) 			;Engine Power
			contact(4.4)		;Track-ground contact length, in m
			wheelbase(2.62)		;Distance between center of left and right side roadwheels, in m
			pressure(0.79)		;Ground pressure on road, in kg/cm^2
			coeff_accel(6)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering rate, (0,10]
			coeff_steer_eff(5)	;Modifier for steering efficiency, (0,10]
			fuel(600) 			;Fuel capacity in Litres.
			type(diesel)		;Fuel type. (diesel OR fuel)
			range(120) 			;Range in km, off-road.
			maxslope(73)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -5 25}
		{speed2 5}
	}
	{bone "turret"
		("turret_heavy" power_traverse(12))
	}
	{##bone "commander_rot"
		{speed2 180}
	}
}