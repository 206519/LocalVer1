{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle_big.inc" scale(0.9))
	{props "td" "heavy" "-turret" "vision_lev05" "muzzle_150mm_155mm_sides" "diesel" "detect_td_heavy" "test1"}
	{extension "su152.mdl"}
	(include "su152.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_spg"}
	{PatherId "kv1"}
	{collider "tank.heavy"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	("crew_5_human_2")

	{boarder
		{anm "driver"
			{forward {begin "board_kv2_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "left"
			{forward {begin "board_Kv-85"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_Kv-85"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} 	{end "seat_armor"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))
	("seat_human" place(seat5) bone(seat05) door(emit7)  animation(armor1))
	("seat_human" place(seat6) bone(seat06) door(emit8)  animation(armor1))
	("seat_human" place(seat7) bone(seat07) door(emit9)  animation(armor1))

	{extender "inventory"
		{box
			{item "bulletrus_152 aphe" 6}		; 20 rounds
			{item "bulletrus_152 he" 13}
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "152mm_ml20a" filling "bulletrus_152 he" 1}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.20)
			)
		}
	}

	{mass 45500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.90))
		("mobility_spearhead"
			speed(45)			;Max speed when fully accelerated on road, km/h.
			reverse(16.6)		;Max speed in reverse on road, km/h.
			mass(45.5)			;Mass, in metric tons.
			power(600) 			;Engine Power
			contact(4.4)		;Track-ground contact length, in m
			wheelbase(2.62)		;Distance between center of left and right side roadwheels, in m
			pressure(0.78)		;Ground pressure on road, in kg/cm^2
			coeff_accel(6)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering rate, (0,10]
			coeff_steer_eff(5)	;Modifier for steering efficiency, (0,10]
			fuel(600) 			;Fuel capacity in Litres.
			type(diesel)		;Fuel type. (diesel OR fuel)
			range(120) 			;Range in km, off-road.
			maxslope(73)		;Max slope (tan(gradient in degrees) * 100)
		)
	}
	{bone "gun_rot"
		{limits -3 20}
		{speed2 4}
	}
	{bone "turret"
		{limits -12 12}
		{speed2 3}
	}
}