{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "medium" "vision_lev04" "muzzle_75mm_76mm" "smoke" "2in_wp" "muzzle_hmg_m2hb"}
	{extension "m4a1_76w_mid.mdl"}
	(include  "m4a1_76w_mid.ext")
	{PatherId "m4_76_vvss"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	("crew_5_human_extended2")
	("charger_visible2")

	{sensor
		{visor "main"
			{vision "tank_range_M71"}
		}
		{Visor "driver"
			{vision "tank_driver_Sherman"}
		}
		{visor "around"
			{vision "tank_cupola_Sherman"}
		}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_m4_driver"} {end "seat_m4_gunner"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver"}}
		}
		{anm "co_driver"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"} {base "open_co_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_co_driver"}}
		}
		{anm "left"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_m4_crew"} {end "seat_m4_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor2"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit7) animation(armor2))

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "mortareng_50 sm"}
	}

	{extender "inventory"
		{box
			{item "ammo bulletusa_76x539 apcbche" 31}
			{item "ammo bulletusa_76x539 apcbche2" 2}	;71 rounds
			{item "ammo bulletusa_76x539 he" 34}
			{item "ammo bulletusa_76x539 sm" 3}
			{item "ammo hmgun_usa api" 500}				;600 rounds
			{item "ammo mgun_usa belt" 5750}			;6250 rounds
			{item "mortareng_50 sm" 18}					;2-inch smoke mortar
			{item "satchel_charge_usa" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a1c" filling "ammo bulletusa_76x539 apcbche2" 1}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic_stabilised"
				zeroing(5.0)
				dispersion(1.0)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{weapon "browning_m2" filling "hmgun_usa api" 100}
			{gunner "charger"}
			{charger "charger"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 32024}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.3) len(0.7))
		("mobility_spearhead"
			speed(39.3)			;Max speed when fully accelerated on road, km/h.
			reverse(5.08)		;Max speed in reverse on road, km/h.
			mass(32.024)		;Mass, in metric tons.
			power(400) 			;Engine Power - where did 460 come from? it's 375 net
			contact(3.7338)		;Track-ground contact length, in m
			wheelbase(2.11)		;Distance between center of left and right side roadwheels, in m
			pressure(1.02)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(3)	;Modifier for steering, (0,10]
			coeff_steer_eff(6)	;Modifier for steering, (0,10]
			fuel(662.45) 		;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(115) 			;Range in km, off-road.
			maxslope(60)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 25}
		{speed2 5}
	}
	{bone "turret"
		("turret_medium" power_traverse(24))
	}
	{bone "cupola_ring"
		{speed2 50}
	}
	{bone "mgun_a_rot1"
		{limits -10 10}
		{speed2 60}
	}
	{bone "mgun_a_rot2"
		{limits -10 65}
		{speed2 60}
	}
}