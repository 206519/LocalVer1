{game_entity
	(include "/properties/tank_assaultgun.ext")
	(include "/properties/selection/vehicle_big.inc" scale(0.95))
	{props "td" "heavy" "-turret" "vision_lev05" "muzzle_85mm_93mm_sides" "shell_eject" "detect_td_heavy"}
	{extension "ferdinand.mdl"}
	(include "ferdinand.ext")
	{collider "tank.heavy"}
	{PatherId "ferdinand"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_Zfl1a"}
		}
		{Visor "driver"
			{vision "tank_driver_PzVI"}
		}
		{Visor "around"
			{bone "none"}
		}
	}

	("crew_6_human_extended")

	{boarder
		{anm "driver"
			{forward {begin "board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver" -1}}
			{reverse {end "board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_Kv-85"} {end "seat_gunner_stand"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_Is-2"} {end "seat_m7_com"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "inventory"
		{box
			{item "bulletger_88_l71 apcbche" 24}	;50 rounds
			{item "bulletger_88_l71 he" 25}
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_kwk43" filling "bulletger_88_l71 apcbche" 1}
			{gunner "gunner gunner3" minWorkers 1}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic_td"
				zeroing(5.0)
				dispersion(0.25)
			)
		}
	}

	{mass 65000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.20) len(0.5))
		("mobility_spearhead"
			speed(30)			;Max speed when fully accelerated on road, km/h.
			reverse(30)			;Max speed in reverse on road, km/h.
			mass(65)			;Mass, in metric tons.
			power(530) 			;Engine Power
			contact(4.12)		;Track-ground contact length, in m
			wheelbase(2.7)		;Distance between center of left and right side roadwheels, in m
			pressure(1.23)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering rate, (0,10]
			coeff_steer_eff(6)	;Modifier for steering efficiency, (0,10]
			fuel(950) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(90) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -5 14}
		{speed2 4}
	}
	{bone "turret"
		{limits -14 14}
		{speed2 4.5}
	}
}