{game_entity
	(include "/properties/tank.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "muzzle_50mm_57mm" "smoke" "nkav"}
	{extension "panzer4d.mdl"}
	(include  "panzer4d.ext")
	{PatherId "panzer4d"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{extender "enumerator"
		{digit_folder "ger"}
	}

	("crew_5_human_extended")
	;("commander_visible")
	
	{sensor
		{visor "main"
			{vision "tank_range_TZF5"}
		}
		{Visor "driver"
			{vision "tank_driver_PzIV"}
		}
		{Visor "around"
			{vision "tank_cupola_Pz34"}
		}
	}

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_commander_hatch"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_cromwell"} {end "seat_commander_hatch"}}
			{reverse 	{end	"board_cromwell" -1}}
		}
		{anm "right"
			{forward	{begin	"board_cromwell"} {end "seat_commander_hatch"}}
			{reverse 	{end	"board_cromwell" -1}}
		}
		{anm "armor"
			{forward	{begin	"board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "armor1"
			{forward	{begin	"board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "seat_crew_cannon1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor2))

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_75_l24 apcbche" 25} 		; 80 rounds
			{item "bulletger_75_l24 he" 50}
			{item "bulletger_75_l24 heat" 10}
			{item "bulletger_75_l24 sm" 4}
			{item "ammo mgun_ger belt" 2550}		; 36 drums (75 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 5}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk37" filling "bulletger_75_l24 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.25)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank_early" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank_early" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 20000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.45))
		("mobility_spearhead"
			speed(42)			;Max speed when fully accelerated on road, km/h.
			reverse(5.8)		;Max speed in reverse on road, km/h.
			mass(20.0)			;Mass, in metric tons.
			power(272) 			;Engine Power
			contact(3.52)		;Track-ground contact length, in m
			wheelbase(2.46)		;Distance between center of left and right side roadwheels, in m
			pressure(0.83)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(3)	;Modifier for steering, (0,10]
			fuel(470) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(130) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -8 20}
		{speed2 6}
	}
	{bone "turret"
		("turret_medium" power_traverse(16))
	}
	{##bone "commander_rot"
		{speed2 180}
	}
}