{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "td" "medium" "-turret" "mantlet" "vision_lev03" "muzzle_50mm_57mm" "shield" "smoke" "nkav"}
	{extension "stug3b.mdl"}
	(include "stug3b.ext")
	{PatherId "panzer3e"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{extender "enumerator"
		{digit_folder "ger"}
	}

	("crew_4_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"} {end "seat_armor"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_armor"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_MiddleArmor"} {end "seat_willis_passenger"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "armor1"
			{forward	{begin	"board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "armor2"
			{forward	{begin	"board_MiddleArmor"} {end "seat_crew_cannon1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))
	
	{sensor
		{visor "main"
			{vision "tank_range_Zfl3x8"}
			{bone "visor1"}
		}
		{Visor "driver"
			{vision "tank_driver_PzII"}
		}
		{visor "around"
			{vision "Varound_poor"}
			{bone "visor"}
		}
	}

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_75_l24 apcbche" 17}		; 44 rounds
			{item "bulletger_75_l24 he" 22}
			;{item "bulletger_75_l24 heat" 8}
			{item "bulletger_75_l24 sm" 4}
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 5}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk37" filling "bulletger_75_l24 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.20)
			)
		}
	}

	{mass 20700}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.6))
		("mobility_spearhead"
			speed(40.0)			;Max speed when fully accelerated on road, km/h.
			reverse(4.66)		;Max speed in reverse on road, km/h.
			mass(22.0)			;Mass, in metric tons.
			power(272) 			;Engine Power
			contact(2.86)		;Track-ground contact length, in m
			wheelbase(2.51)		;Distance between center of left and right side roadwheels, in m
			pressure(0.96)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(4)	;Modifier for steering, (0,10]
			fuel(310) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(95) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 6}
	}
	{bone "turret"
		{limits -12 12}
		{speed2 8}
	}
}