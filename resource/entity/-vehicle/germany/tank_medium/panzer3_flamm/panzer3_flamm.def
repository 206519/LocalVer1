{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "medium" "vision_lev04" "shield" "flame"}
	{extension "panzer3_flamm.mdl"}
	(include "panzer3_flamm.ext")
	{PatherId "panzer3m"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{extender "enumerator"
		{digit_folder "ger"}
	}

	("crew_3_human_4")

	{boarder
		{anm "left"
			{forward {begin "board_tank_right"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_left"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor2"
			{forward {begin "board_MiddleArmor"} {end "seat_crew_cannon1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "ammo mgun_ger belt" 3450}		; 25 belts (150 rounds each)
			{item "ammo flame_thrower" 510}
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "14mm_flammenwerfer_pz3" filled}
			{gunner "commander"}
			{charger "commander"}
			("abm_dymamic"
				zeroing(2.0)
				dispersion(0.15)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank" filled}
			{foresight "foresight5"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 22500}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.05))
		("mobility_spearhead"
			speed(40.0)			;Max speed when fully accelerated on road, km/h.
			reverse(5.5)		;Max speed in reverse on road, km/h.
			mass(22.5)			;Mass, in metric tons.
			power(272) 			;Engine Power
			contact(2.86)		;Track-ground contact length, in m
			wheelbase(2.51)		;Distance between center of left and right side roadwheels, in m
			pressure(0.95)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(4)	;Modifier for steering, (0,10]
			fuel(320) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(95) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 8}
	}
	{bone "turret"
		("turret_medium" power_traverse(6)) ;// manual, gunner + loader has handcranks
	}
}
