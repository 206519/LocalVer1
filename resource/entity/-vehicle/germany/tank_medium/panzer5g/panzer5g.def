{game_entity
	(include "panzer5g.inc")
	
	{extender "inventory"
		;{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_75_l70 apcbche" 40} 	; 82 rounds
			{item "bulletger_75_l70 he" 41}
			{item "ammo mgun_ger belt" 4500}		; 32 belts (150 rounds each)
			;{item "mg34_drum" filled {user "mgun"}}
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 6}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk42" filling "bulletger_75_l70 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.25)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 45500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.94))
		("mobility_spearhead"
			speed(45.8)			;Max speed when fully accelerated on road, km/h.
			reverse(3.3)		;Max speed in reverse on road, km/h.
			mass(45.5)			;Mass, in metric tons.
			power(600) 			;Engine Power
			contact(3.92)		;Track-ground contact length, in m
			wheelbase(2.61)		;Distance between center of left and right side roadwheels, in m
			pressure(0.88)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(6)	;Modifier for steering, (0,10]
			coeff_steer_eff(5)	;Modifier for steering, (0,10]
			fuel(700) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(100) 			;Range in km, off-road.
			maxslope(70)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -8 18}
		{speed2 4}
	}
	{bone "turret"
		("turret_spearhead" power_traverse(15.65))
	}
}
	
