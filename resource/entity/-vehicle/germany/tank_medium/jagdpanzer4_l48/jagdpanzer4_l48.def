{game_entity
	(include "/properties/tank_assaultgun.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.1))
	{props "td" "medium" "-turret" "smoke" "nvw" "vision_lev03" "muzzle_75mm_76mm" "shield"}
	{extension "jagdpanzer4_l48.mdl"}
	(include "jagdpanzer4_l48.ext")
	{PatherId "panzer4h"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{texmod "camo2"}

	("crew_4_human")
	

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "right"
			{forward {begin "board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor2"
			{forward {begin "board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{sensor
		{visor "main"
			{vision "tank_range_Zfl3x8"}
			{bone "visor1"}
		}
		{Visor "driver"
			{vision "tank_driver_PzII"}
		}
		{visor "around"
			{vision "Varound_poor"}
			{bone "visor"}
		}
	}

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_75_l43 apcbche" 29} 	; 79 rounds
			{item "bulletger_75_l43 he" 40}
			;{item "bulletger_75_l43 apcr" 2}
			{item "bulletger_75_l43 heatc" 10}
			{item "ammo mgun_ger belt" 1050}		; 8 belts (150 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 6}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_stuk40_l48" filling "bulletger_75_l43 apcbche" 1}
			{gunner "gunner"}
			{charger "charger commander" minWorkers 1}
			("abm_dymamic"
				zeroing(3.00)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg42_tank" filled}
			{foresight "foresight4"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 24000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.5))
		("mobility_spearhead"
			speed(40)			;Max speed when fully accelerated on road, km/h.
			reverse(5.5)		;Max speed in reverse on road, km/h.
			mass(24.0)			;Mass, in metric tons.
			power(272) 			;Engine Power
			contact(3.52)		;Track-ground contact length, in m
			wheelbase(2.46)		;Distance between center of left and right side roadwheels, in m
			pressure(0.86)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(3)	;Modifier for steering, (0,10]
			fuel(470) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(130) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -8 15}
		{speed2 6}
	}
	{bone "turret"
		{limits -15 12}
		{speed2 8}
	}
}
