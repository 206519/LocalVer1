{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "spg" "medium" "-turret" "vision_lev05" "muzzle_122mm_128mm" "detect_spg"  "smoke" "nkav"}
	{Extension "sig33b.mdl"}
	(include "sig33b.ext")
	{PatherId "panzer3m"}
	{targetclass "tank_medium"}
	{targetSelector "cannon_howitzer"}

	{extender "enumerator"
		{digit_folder "ger"}
	}
	
	{sensor
		{visor "around"
			{vision "Varound_poor"}	
		}
	}

	("crew_5_human")

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"} {end "seat_armor"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_150_l11 he" 29}		; 30 rounds
			{item "ammo mgun_ger belt" 450}			; 4 belts (150 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 5}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "150mm_l11" filling "bulletger_150_l11 he" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.15)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{rotate}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 26000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.05))
		("mobility_spearhead"
			speed(38.0)			;Max speed when fully accelerated on road, km/h.
			reverse(5.2)		;Max speed in reverse on road, km/h.
			mass(26.0)			;Mass, in metric tons.
			power(272) 			;Engine Power
			contact(2.86)		;Track-ground contact length, in m
			wheelbase(2.51)		;Distance between center of left and right side roadwheels, in m
			pressure(0.92)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(4)	;Modifier for steering, (0,10]
			fuel(310) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(85) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -3 25}
		{speed2 5}
	}
	{bone "turret"
		{limits -3 3}
		{speed2 5}
	}
}