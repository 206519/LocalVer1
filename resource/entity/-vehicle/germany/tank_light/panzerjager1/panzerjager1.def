{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
	{props "td" "light" "-turret" "mantlet" "vision_lev02" "muzzle_37mm_47mm_sides" "shell_eject" "shield" "open_top" "detect_td_light"}
	{extension "panzerjager1.mdl"}
	(include "panzerjager1.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_medium"}
	{patherId "panzer1"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_tank_left"} {end "pose_flak38-1_charger"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "left"
			{forward {begin "board_tank_left"} {end "pose_vickers_gunlaeyr-R"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "pose_flak41_gunlayer_1"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	}

	("crew_human_visible_anm"	place(driver) 	 door(emit1) visor(driver) anm_left(driver) anm_right(driver))
	("crew_human_visible_anm"	place(commander) door(emit2) visor(around) anm_left(right)  anm_right(right))
	("crew_human_visible_anm"	place(gunner) 	 door(emit1) visor(main)   anm_left(left)   anm_right(left))
	
	{sensor
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_47 apche" 41} 		; 84 rounds
			{item "bulletger_47 he" 42}
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "47mm_pakt_2" filling "bulletger_47 apche" 1}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic_td"
				zeroing(1.5)
				dispersion(0.25)
			)
		}
	}

	{mass 6400}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.43))
		("mobility_spearhead"
			speed(40)			;Max speed when fully accelerated on road, km/h.
			reverse(3.7)		;Max speed in reverse on road, km/h.
			mass(6.4)			;Mass, in metric tons.
			power(100) 			;Engine Power
			contact(2.4)		;Track-ground contact length, in m
			wheelbase(1.67)		;Distance between center of left and right side roadwheels, in m
			pressure(0.48)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)		;Modifier for steering, (0,10]
			coeff_steer_eff(5)		;Modifier for steering, (0,10]
			fuel(146) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(115) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -8 10}
		{speed2 8}
	}
	{bone "turret"
		{limits -17.5 17.5}
		{speed2 8}
	}
}