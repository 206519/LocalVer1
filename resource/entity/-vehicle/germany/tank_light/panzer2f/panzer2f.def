{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "muzzle_20mm_25mm_auto" "shield" "smoke" "nkav" "detect_tank_light"}
	{extension "panzer2f.mdl"}
	(include "panzer2f.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_zenite"}
	{patherId "panzer2"}
	{collider "tank.light"}

	("crew_3_human_2")
	
	{sensor
		{visor "main"
			{vision "tank_range_TZF5"}
		}
		{Visor "driver"
			{vision "tank_driver_PzII"}
		}
	}

	{boarder
		{anm "left"
			{forward {begin "board_Kv"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "seat_m7_com"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "seat_armor"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_middlearmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor2"
			{forward {begin "board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor2))

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_20_auto ap" 60}		; 18 magazines (10 rounds each)
			{item "bulletger_20_auto hvap" 20}
			{item "bulletger_20_auto he" 90}
			{item "ammo mgun_ger belt" 1950}		; 15 belts (150 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 5}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_kwk30" filling "bulletger_20_auto ap" 10}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.35)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{weapon "mg34_tank" filled}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 9500}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.2) len(0.55))
		("mobility_spearhead"
			speed(40)			;Max speed when fully accelerated on road, km/h.
			reverse(5)			;Max speed in reverse on road, km/h.
			mass(9.5)			;Mass, in metric tons.
			power(140) 			;Engine Power
			contact(2.4)		;Track-ground contact length, in m
			wheelbase(1.88)		;Distance between center of left and right side roadwheels, in m
			pressure(0.66)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)		;Modifier for steering, (0,10]
			coeff_steer_eff(5)		;Modifier for steering, (0,10]
			fuel(170) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(125) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 15}
	}
	{bone "turret"
		("turret_light" power_traverse(6)) ;// manual
	}
}