{game_entity
	(include "/properties/tank.ext")
	
	(include "/properties/selection/vehicle_elongated.inc" scale(1.1))
	{props "light" "vision_lev03" "muzzle_37mm_47mm" "shield" "smoke" "nkav" "detect_tank_light"}
	{extension "pz38t_f.mdl"}
	(include "pz38t_f.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{patherId "panzer38"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	("crew_4_human_2")
	;("commander_visible")

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	}

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_37 aphe" 35}		; 90 rounds
			{item "bulletger_37 he" 45}
			{item "bulletger_37 apcr" 9}
			{item "ammo mgun_ger belt" 2500}	; 27 belts (100 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 5}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_kwk38t" filling "bulletger_37 aphe" 1}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic"
				zeroing(5.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg37t" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg37t" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 9850}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.32) len(0.12))
		("mobility_spearhead"
			speed(42.0)			;Max speed when fully accelerated on road, km/h.
			reverse(6.1)		;Max speed in reverse on road, km/h.
			mass(9.85)			;Mass, in metric tons.
			power(125) 			;Engine Power
			contact(2.615)		;Track-ground contact length, in m
			wheelbase(1.77)		;Distance between center of left and right side roadwheels, in m
			pressure(0.64)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)		;Modifier for steering, (0,10]
			coeff_steer_eff(4)		;Modifier for steering, (0,10]
			fuel(220) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(100) 			;Range in km, off-road.
			maxslope(75)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 25}
		{speed2 10}
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
	{##bone "commander_rot"
		{speed2 180}
	}
}