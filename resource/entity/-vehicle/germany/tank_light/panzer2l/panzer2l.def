{game_entity
	(include "/properties/tank.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "muzzle_20mm_25mm_auto" "shield" "smoke" "nwg" "detect_tank_light"}
	{extension "panzer2l.mdl"}
	(include "panzer2l.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_zenite"}
	{patherId "panzer2l"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_TZF5"}
		}
		{Visor "driver"
			{vision "tank_driver_PzII"}
		}
	}

	("crew_4_human")

	{boarder
		{anm "left"
			{forward {begin "board_Kv"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "seat_m7_com"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 20}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_20_auto ap" 120}	; 32 magazines (10 rounds each)
			{item "bulletger_20_auto hvap" 30}
			{item "bulletger_20_auto he" 160}
			{item "ammo mgun_ger belt ap" 2100}	; 15 belts (150 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_kwk38" filling "bulletger_20_auto ap" 10}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(1.75)
				dispersion(0.30)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{weapon "mg34_tank" filling "ammo mgun_ger belt ap" 150}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 11800}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.2) len(0.76))
		("mobility_spearhead"
			speed(60)			;Max speed when fully accelerated on road, km/h.
			reverse(10)		;Max speed in reverse on road, km/h.
			mass(11.8)			;Mass, in metric tons.
			power(180) 			;Engine Power
			contact(2.16)		;Track-ground contact length, in m
			wheelbase(2.08)		;Distance between center of left and right side roadwheels, in m
			pressure(0.77)		;Ground pressure on road, in kg/cm^2
			coeff_accel(6)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)	;Modifier for steering, (0,10]
			coeff_steer_eff(5)	;Modifier for steering, (0,10]
			fuel(235) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(155) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 15}
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
}