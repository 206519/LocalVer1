{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "td" "light" "-turret" "mantlet" "vision_lev03" "muzzle_75mm_76mm" "shield" "detect_td_light"}
	{extension "hetzer.mdl"}
	(include "hetzer.ext")
	{patherId "hetzer"}
	{collider "tank.light"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_Zfl3x8"}
			{bone "visor1"}
		}
		{visor "around"
			{vision "none"}
			{bone "visor"}
		}
		{visor "top"
			{vision "tank_remote-mg"}
			{bone "mgun"}
		}
	}

	("crew_4_human")
	("crew_human" place(commander) door(emit1) door2(emit2) visor(top))

	{boarder
		{anm "left"
			{forward {begin "board_hetzer"} {end "seat_armor"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "right"
			{forward {begin "board_hetzer"} {end "seat_gunner_stand"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_75_l43 apcbche" 19}		; 41 rounds
			{item "bulletger_75_l43 he" 21}
			;{item "bulletger_75_l43 apcr" 1}
			{item "ammo mgun_ger drum" 550}				; 12 drums (50 rounds each)
			{item "mg34_drum" filling "ammo mgun_ger drum" 50 {user "mgun"}}
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_pak39" filling "bulletger_75_l43 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_td"
				zeroing(3.50)
				dispersion(0.25)
			)
		}
		{place "mgun"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 16000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.45))
		("mobility_spearhead"
			speed(40.0)			;Max speed when fully accelerated on road, km/h.
			reverse(5.8)		;Max speed in reverse on road, km/h.
			mass(16)			;Mass, in metric tons.
			power(150) 			;Engine Power
			contact(2.72)		;Track-ground contact length, in m
			wheelbase(2.12)		;Distance between center of left and right side roadwheels, in m
			pressure(0.85)		;Ground pressure on road, in kg/cm^2
			coeff_accel(4)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(4)		;Modifier for steering, (0,10]
			coeff_steer_eff(3)		;Modifier for steering, (0,10]
			fuel(320) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(130) 			;Range in km, off-road.
			maxslope(47)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -6 10}
		{speed2 8}
	}
	{bone "turret"
		{limits -5 11}
		{speed2 8}
	}
}