{game_entity
	(include "/properties/tank.ext")
	
	(include "/properties/selection/vehicle_elongated.inc" scale(0.95))
	{props "light" "vision_lev03" "shield" "tractor" "tractor_light" "detect_tank_mg" "panzer1"}
	{extension "panzer1b.mdl"}
	(include "panzer1b.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_bullet"}
	{patherId "panzer1"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}
	
	{sensor
		{visor "main"
			{bone "foresight14"}
			{vision "tank_main_mg"}
		}
		{visor "around"
			{vision "none"}
		}
	}

	("crew_driver" door(emit0) door2(emit2) door3(emit2))
	("crew_human" place(commander)	door(emit2) door2(emit2) visor(main))

	{boarder
		{anm "driver"
			{forward {begin "board_LowTank_left"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_LowTank_left"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_LowTank_left"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor"
			{forward {begin "board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_lowArmor"} {end "seat_armor"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4) animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5) animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6) animation(armor1))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "ammo mgun_ger mg13" 2200}			; 90 drums (25 rounds each)
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		{place "mgun"
			{Barrels 2}
			{type "main"}
			{weapon "mg13_no_bipod_x2" filling "ammo mgun_ger mg13" 50}
			{charger "commander"}
			{gunner "commander"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 5800}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.43))
		("mobility_spearhead"
			speed(40.0)			;Max speed when fully accelerated on road, km/h.
			reverse(3.7)		;Max speed in reverse on road, km/h.
			mass(5.8)			;Mass, in metric tons.
			power(100) 			;Engine Power
			contact(2.4)		;Track-ground contact length, in m
			wheelbase(1.67)		;Distance between center of left and right side roadwheels, in m
			pressure(0.76)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)		;Modifier for steering, (0,10]
			coeff_steer_eff(5)		;Modifier for steering, (0,10]
			fuel(148) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(115) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 12}
	}
	{bone "turret"
		{speed2 14}
	}
}