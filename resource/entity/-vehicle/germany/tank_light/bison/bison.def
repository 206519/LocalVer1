{game_entity
	(include "/properties/tank_assaultgun.ext")
	
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
	{props "spg" "light" "-turret" "mantlet" "vision_lev05" "muzzle_150mm_155mm" "shield" "tractor" "tractor_light" "open_top" "detect_spg"}
	{Extension "bison.mdl"}
	(include "bison.ext")
	{targetclass "tank_light"}
	{targetSelector "cannon_howitzer"}
	{patherId "panzer1"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	("crew_human_visible_anm"	place(driver) 	 door(emit1) door2(emit2) visor(driver) anm_left(driver) anm_right(driver))
	("crew_human_visible_anm"	place(charger) 	 door(emit1) door2(emit2) visor(driver) anm_left(driver) anm_right(right))
	("crew_human_visible_anm"	place(commander) door(emit1) door2(emit2) visor(around) anm_left(right)  anm_right(commander))
	("crew_human_visible_anm"	place(gunner) 	 door(emit1) door2(emit2) visor(main)   anm_left(left)   anm_right(left))

	{boarder
		{anm "driver"
			{forward {begin "board_tank_left"} {end "pose_flak38-1_charger"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "left"
			{forward {begin "board_tank_left"} {end "pose_pak40_gunlayer" 10}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "pose_pak40_charger" 10}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "commander" 
			{forward {begin "board_tank_left"} {end "pose_squat_empty"}}
			{reverse {end "emit_tank_1_hold"}}
		}
	}

	{sensor
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_150_l11 he" 8}		;//historically, only carried 4 rounds at time. Additional ammo was stored in a Sd.Kfz.10
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "150mm_sig33_2" filling "bulletger_150_l11 he" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(4.5)
				dispersion(0.25)
			)
		}
	}

	{mass 8500}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.43))
		("mobility_spearhead"
			speed(40.0)			;Max speed when fully accelerated on road, km/h.
			reverse(3.7)		;Max speed in reverse on road, km/h.
			mass(8.5)			;Mass, in metric tons.
			power(100) 			;Engine Power
			contact(2.4)		;Track-ground contact length, in m
			wheelbase(1.67)		;Distance between center of left and right side roadwheels, in m
			pressure(0.76)		;Ground pressure on road, in kg/cm^2
			coeff_accel(5)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)		;Modifier for steering, (0,10]
			coeff_steer_eff(5)		;Modifier for steering, (0,10]
			fuel(148) 			;Fuel capacity in Litres.
			type(fuel)			;Fuel type. (diesel OR fuel)
			range(115) 			;Range in km, off-road.
			maxslope(58)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -4 55}
		{speed2 6}
	}
	{bone "turret"
		{limits -5 5}
		{speed2 3}
	}
}