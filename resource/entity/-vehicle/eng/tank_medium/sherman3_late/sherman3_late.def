{game_entity
	(include "/properties/tank.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "medium" "vision_lev04" "muzzle_75mm_76mm" "diesel"}
	{extension "sherman3_late.mdl"}
	(include  "sherman3_late.ext")
	{PatherId "m4_75_vvss"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	("crew_5_human_extended2")
	;("commander_visible")

	{sensor
		{visor "main"
			{vision "tank_range_M55"}
		}
		{Visor "driver"
			{vision "tank_driver_Sherman"}
		}
		{visor "around"
			{vision "tank_cupola_Sherman_split"}
		}
	}
	
	{extender "enumerator"
		{digit_folder "us2"}
	}

	{texmod "late"}

	{boarder
		{anm "driver"
			{forward {begin "board_m4_driver"} {end "seat_commander_hatch"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver"}}
		}
		{anm "co_driver"
			{forward {begin "board_m4_crew"} {end "seat_commander_hatch"} {base "open_co_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_co_driver"}}
		}
		{anm "left"
			{forward {begin "board_m4_crew"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_m4_crew"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor2"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit7) animation(armor2))

	{extender "inventory"
		{box
			{item "ammo bulletusa_75x350 apcbc" 38}	; 97 rounds ;40/60% AP/HE
			{item "ammo bulletusa_75x350 he" 59}
			{item "ammo mgun_usa belt" 4250}			; 19 belts (250 rounds each)
			{item "satchel_charge_usa" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_m3" filling "ammo bulletusa_75x350 apcbc" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3)
				dispersion(0.3)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "browning_m19a4_tank" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "browning_m19a4_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{##place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 32300}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.53))
		("mobility_spearhead"
			speed(48.28)		;Max speed when fully accelerated on road, km/h.
			reverse(6.14)		;Max speed in reverse on road, km/h.
			mass(32.3)		;Mass, in metric tons.
			power(410) 			;Engine Power
			contact(3.7338)		;Track-ground contact length, in m
			wheelbase(2.11)		;Distance between center of left and right side roadwheels, in m
			pressure(1.01)		;Ground pressure on road, in kg/cm^2
			coeff_accel(7)		;Modifier for acceleration, (0,10]
			coeff_steer_rate(5)		;Modifier for steering, (0,10]
			coeff_steer_eff(7)		;Modifier for steering, (0,10]
			fuel(560.241) 		;Fuel capacity in Litres.
			type(diesel)		;Fuel type. (diesel OR fuel)
			range(140) 			;Range in km, off-road.
			maxslope(60)		;Max slope (tan(gradient in degrees) * 100)
		)
	}

	{bone "gun_rot"
		{limits -10 25}
		{speed2 5}
	}
	{bone "turret"
		("turret_medium" power_traverse(24))
	}
	{##bone "commander_rot"
		{speed2 180}
	}
	{bone "cupola_ring"
		{speed2 50}
	}
}